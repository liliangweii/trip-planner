# ===== LLM（OpenAI 兼容接口）=====
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== Milvus =====
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=travel_knowledge
MILVUS_TOKEN=

# ===== Embedding =====
# 方案 B（当前选择）：API 型 Embedding，仅稠密向量；稀疏路由 Milvus 2.4+ 内置 BM25 函数补齐
# 推荐：硅基流动 https://api.siliconflow.cn/v1 ，模型 BAAI/bge-m3（有免费额度）
# 方案 A：EMBEDDING_PROVIDER=local_bge，无需下面三项 API 配置
EMBEDDING_PROVIDER=api
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=BAAI/bge-m3

# ===== Reranker（方案 B：API 精排，硅基流动 /rerank）=====
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_ENABLED=true
RERANK_API_BASE=https://api.siliconflow.cn/v1
RERANK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 高德地图 =====
AMAP_API_KEY=

# ===== 会话记忆 =====
SQL_HISTORY_URL=sqlite:///./chat_history.db

# ===== Redis 缓存（可选）=====
# 行程规划结果缓存。未启动 Redis 或连接失败时自动降级为"不缓存"，不影响规划功能。
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
PLAN_CACHE_TTL=43200

# ===== 检索参数 =====
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RRF_K=60

# ===== 规划模式 =====
# fast=确定性管道+单次生成（默认，~30s）；agent=Tool-Calling Agent 完整编排（~200s）
PLANNER_MODE=fast

# ===== 服务运行 =====
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
